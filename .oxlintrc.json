{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "overrides": [
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-router", "**/app/**"],
                "message": "src/engine no depende de ningún framework: no puede importar React ni nada de src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*", "!../../*"],
                "message": "Las features no se importan entre sí; se combinan en una pantalla o una ruta."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/routes/**", "src/app/screens/**", "src/app/root.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/*/*"],
                "message": "Import a feature through its index (../features/<name>), not its files."
              }
            ]
          }
        ]
      }
    }
  ]
}
